rule hicap_hinfluenzae:
    input:
        contigs  = ancient(config['work_dir']+'{sample_id_pattern}_contigs.fasta'),
        sif_file = ancient(config['hicap_hinfluenzae_sif'])
    envmodules:
        'singularity'
    output:
        config['output_directory']+'{sample_id_pattern}_hi_hicap.tsv'
    shell: 
        """
        mkdir -p {config[scratch]}hicap/
        cp {input.contigs} {config[scratch]}hicap/
        singularity --silent exec --bind {config[output_directory]},{config[work_dir]}:{config[output_directory]},{config[work_dir]} {input.sif_file} hicap -q {config[scratch]}hicap/$(basename {input.contigs}) -o {config[scratch]}hicap/
        
        if [ -f {config[scratch]}hicap/{wildcards.sample_id_pattern}.tsv ]; then
            mv {config[scratch]}hicap/{wildcards.sample_id_pattern}.tsv {output}
        else
            #creating empty file just in case to make snakemake not stop if typing has failed for tool-specific reasons
            touch {config[output_directory]}{wildcards.sample_id_pattern}_hi_hicap.tsv
        fi

        rm -r {config[scratch]}hicap/{wildcards.sample_id_pattern}*
        rmdir --ignore-fail-on-non-empty {config[scratch]}hicap/
        """


