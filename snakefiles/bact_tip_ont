rule hicap_hinfluenzae:
    input:
        contigs  = ancient(config['output_directory']+'{sample_id_pattern}_contigs.fasta'),
        sif_file = ancient(config['hicap_hinfluenzae_sif'])
    # envmodules:
    #     'singularity'
    output:
        config['output_directory']+'{sample_id_pattern}_hi_hicap.tsv'
    log:
        config['output_directory']+'logs/'+'{sample_id_pattern}_hicap_hinfluenzae.hicap.log'
    shell: 
        """
        mkdir -p {config[scratch]}hicap/ 2>> {log}
        cp {input.contigs} {config[scratch]}hicap/ 2>> {log}
        singularity --silent exec --bind {config[output_directory]}:{config[output_directory]} {input.sif_file} hicap -q {config[scratch]}hicap/$(basename {input.contigs}) -o {config[scratch]}hicap/ 2>> {log}
        
        if [ -f {config[scratch]}hicap/{wildcards.sample_id_pattern}_contigs.tsv ]; then
            mv {config[scratch]}hicap/{wildcards.sample_id_pattern}_contigs.tsv {output} 2>> {log}
        else
            #creating empty file just in case to make snakemake not stop if typing has failed for tool-specific reasons
            touch {config[output_directory]}{wildcards.sample_id_pattern}_hi_hicap.tsv 2>> {log}
        fi

        rm -r {config[scratch]}hicap/{wildcards.sample_id_pattern}* 2>> {log}
        rmdir --ignore-fail-on-non-empty {config[scratch]}hicap/ 2>> {log}
        """


rule plasmidtype_abaumannii:
    input:
        contigs  = ancient(config['output_directory']+'{sample_id_pattern}_contigs.fasta'),
        sif_file = ancient(config['tip_tool_configs']['abaumanniiplasmidtype']['abp_sif']),
        database = ancient(config['tip_tool_configs']['abaumanniiplasmidtype']['database'])
    output:
        config['output_directory']+'{sample_id_pattern}_abplasmidtype.txt'
    # envmodules:
    #     'singularity'
