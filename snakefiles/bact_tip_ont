                    logfile.write(f"[{datetime.now().isoformat()}] Successfully wrote output to {output[0]}\n")
                else:
                    open(output[0], 'a').close()
                    logfile.write(f"[{datetime.now().isoformat()}] WARNING: API did not return dict. Created empty output file.\n")

            except Exception as e:
                open(output[0], 'a').close()
                logfile.write(f"[{datetime.now().isoformat()}] ERROR: {type(e).__name__}: {str(e)}\n")
                logfile.write(traceback.format_exc() + "\n")
            

