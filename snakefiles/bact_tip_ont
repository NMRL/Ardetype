        mv {config[scratch]}plasmidtype_ab_{wildcards.sample_id_pattern}/$(basename {output}) {output} 2>> {log}
        rm -r {config[scratch]}plasmidtype_ab_{wildcards.sample_id_pattern}/ 2>> {log}
        """

