rule chewbbaca_cgmlst:
    input:
        image_file    = ancient(config['tip_tool_configs']['chewbbaca']['chewbbaca_sif']),
        contigs       = ancient(config['output_directory']+'{sample_id_pattern}_contigs.fasta')
    output:
        chewbbaca     = config['output_directory']+'{sample_id_pattern}_chewbbaca/results_alleles.tsv'
    log:
        config['output_directory'] + 'logs/' + '{sample_id_pattern}_chewbbaca_cgmlst.chewbbaca.log'
    run:
        sample_id    = wildcards.sample_id_pattern
        scratch_path = f'{config["scratch"]}chewbbaca_{sample_id}'
        output_dir   = f'{config["output_directory"]}{sample_id}_chewbbaca/'

        # chewBBACA rejects input files whose prefix (filename before the first ".")
        # is longer than 30 characters. Long sample ids get a short surrogate id for
        # the actual chewBBACA input file; results are renamed back to sample_id below.
        chewbbaca_id = sample_id
        if len(f'{sample_id}_contigs') > 30:
            chewbbaca_id = 'id' + hashlib.md5(sample_id.encode()).hexdigest()[:16]

        os.system(f'''
        if [ -d "{scratch_path}" ]; then rm -Rf {scratch_path} 2>> {log[0]}; fi

        cd {config["databases"]}{config["tip_tool_configs"]["chewbbaca"]["chewbbaca_dtb"]} 2>> {log[0]}
        mkdir -p {scratch_path} 2>> {log[0]}
        mkdir -p {scratch_path}/{sample_id}_chewbbaca_input/ 2>> {log[0]}
        cp {input.contigs} {scratch_path}/{sample_id}_chewbbaca_input/{chewbbaca_id}_contigs.fasta 2>> {log[0]}

        singularity --silent exec --bind {scratch_path},{config["output_directory"]},{config["output_directory"]},{config["databases"]}{config["tip_tool_configs"]["chewbbaca"]["chewbbaca_dtb"]}:{scratch_path},{config["output_directory"]},{config["output_directory"]},{config["databases"]}{config["tip_tool_configs"]["chewbbaca"]["chewbbaca_dtb"]} {input.image_file} chewBBACA.py AlleleCall --no-inferred --cpu {config["tip_tool_configs"]["chewbbaca"]["chewbbaca_cores"]} -i {scratch_path}/{sample_id}_chewbbaca_input/ -g {chewbbaca_species_map[sample_id]['db']} -o {scratch_path}/{sample_id}_chewbbaca/ 2>> {log[0]}
        mv {scratch_path}/{sample_id}_chewbbaca/* {output_dir} 2>> {log[0]}

        rm -r {scratch_path} 2>> {log[0]}
        ''')

        if chewbbaca_id != sample_id:
            with open(log[0], "a") as logfile:
                logfile.write(f"\n[{datetime.now().isoformat()}] Restoring sample id '{sample_id}' in chewBBACA output files (temporary id used for the run: '{chewbbaca_id}').\n")
            for fname in os.listdir(output_dir):
                fpath = os.path.join(output_dir, fname)
                if not os.path.isfile(fpath):
                    continue
                try:
                    with open(fpath, 'r') as f:
                        content = f.read()
                except UnicodeDecodeError:
                    continue
                if chewbbaca_id in content:
                    with open(fpath, 'w') as f:
                        f.write(content.replace(chewbbaca_id, sample_id))

        with open(log[0], "a") as logfile:
            logfile.write(f"\n[{datetime.now().isoformat()}] Starting QC DataFrame post-processing.\n")
            try:
                qc_data_path = f'{output_dir}results_statistics.tsv'
                logfile.write(f"[{datetime.now().isoformat()}] Reading QC file: {qc_data_path}\n")
                df = pd.read_csv(qc_data_path, sep='\t')

                df['scheme_version'] = [chewbbaca_species_map[sample_id]['version']] * len(df)
                df['scheme_origin']  = [chewbbaca_species_map[sample_id]['origin']] * len(df)
                df['locus_count']    = [chewbbaca_species_map[sample_id]['locus_count']] * len(df)

                df.to_csv(qc_data_path, sep='\t', header=True, index=False)
                logfile.write(f"[{datetime.now().isoformat()}] Successfully updated and saved QC file.\n")
            except Exception as e:
                logfile.write(f"[{datetime.now().isoformat()}] ERROR during QC DataFrame update: {str(e)}\n")

