rule publmst_ngonorrhoe:
    input:
        contigs = ancient(config['output_directory']+'{sample_id_pattern}_contigs.fasta')
    output:
        config['output_directory']+'{sample_id_pattern}_ngmast.json'
    log:
        config['output_directory'] + 'logs/' + '{sample_id_pattern}_publmst_ngonorrhoe.ngmast.log'
    run:
        with open(log[0], "a") as logfile:
            try:
                logfile.write(f"[{datetime.now().isoformat()}] Starting API call for {input.contigs}\n")
                api_output = hk.type_contigs_api(input.contigs, 'Neisseria gonorrhoeae')

                if isinstance(api_output, dict):
                    hk.write_json(api_output, output[0])
                    logfile.write(f"[{datetime.now().isoformat()}] Successfully wrote JSON to {output[0]}\n")
                else:
                    open(output[0], 'a').close()  # safer alternative to os.system('touch ...')
                    logfile.write(f"[{datetime.now().isoformat()}] API returned non-dict result. Created empty output.\n")

