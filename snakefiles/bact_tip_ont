        config['output_directory']+'logs/'+'{sample_id_pattern}_plasmidtype_abaumannii.log'
    shell:
        """
        mkdir -p {config[scratch]}plasmidtype_ab_{wildcards.sample_id_pattern}/ 2>> {log}
        cp {input.contigs} {config[scratch]}plasmidtype_ab_{wildcards.sample_id_pattern}/ 2>> {log}

