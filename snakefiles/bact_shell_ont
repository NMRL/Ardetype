rule amrfinderplus:
    input:
        hamr_sif      = ancient(config['hamronization_sif']),
        amrfinder_sif = ancient(config['amrfinderplus_sif']),
        contigs       = ancient(config['work_dir']+'{sample_id_pattern}_contigs.fasta')
    output:
        config['output_directory']+"{sample_id_pattern}_amrfinderplus.tab",
        config['output_directory']+"{sample_id_pattern}_amrfinderplus_point.tab",
        config['output_directory']+"{sample_id_pattern}_amrfinderplus_found_seq.fasta"
    log:
        config['output_directory']+"logs/{sample_id_pattern}_amrfinderplus.amrfinderplus.log"
    run:
        if wildcards.sample_id_pattern in org_dict:
            os.system(f"""
            singularity --silent exec --bind {config["output_directory"]},{config["work_dir"]}:{config["output_directory"]},{config["work_dir"]} {input.amrfinder_sif} amrfinder --mutation_all {output[1]} --organism {org_dict[wildcards.sample_id_pattern]} --nucleotide_output {output[2]} -n {input.contigs} > {output[0]} 2>> {log[0]}
            """)
        else:
            os.system(f"""
            singularity --silent exec --bind {config["output_directory"]},{config["work_dir"]}:{config["output_directory"]},{config["work_dir"]} {input.amrfinder_sif} amrfinder --nucleotide_output {output[2]} -n {input.contigs} > {output[0]} 2>> {log[0]}
            touch {output[1]} 2>> {log[0]}
            """)


