            fi
            
            mkdir -p {config['output_directory']}{wildcards.sample_id_pattern}_resfinder/ 2>> {log[0]}
            mv {config['scratch']}resfinder_output_{wildcards.sample_id_pattern}/pheno_table.txt {config['output_directory']}{wildcards.sample_id_pattern}_resfinder/ 2>> {log[0]}
            mv {config['scratch']}resfinder_output_{wildcards.sample_id_pattern}/ResFinder_Hit_in_genome_seq.fsa {config['output_directory']}{wildcards.sample_id_pattern}_resfinder/ 2>> {log[0]}
            mv {config['scratch']}resfinder_output_{wildcards.sample_id_pattern}/ResFinder_Resistance_gene_seq.fsa {config['output_directory']}{wildcards.sample_id_pattern}_resfinder/ 2>> {log[0]}
            mv {config['scratch']}resfinder_output_{wildcards.sample_id_pattern}/ResFinder_results_tab.txt {config['output_directory']}{wildcards.sample_id_pattern}_resfinder/ 2>> {log[0]}
            mv {config['scratch']}resfinder_output_{wildcards.sample_id_pattern}/ResFinder_results.txt {config['output_directory']}{wildcards.sample_id_pattern}_resfinder/ 2>> {log[0]}
            mv {config['scratch']}resfinder_output_{wildcards.sample_id_pattern}/{wildcards.sample_id_pattern}_resfinder.hamr.tab {config['output_directory']}{wildcards.sample_id_pattern}_resfinder/ 2>> {log[0]}
            
            rm -r {config['scratch']}db-resfinder_{wildcards.sample_id_pattern}/ {config['scratch']}resfinder_output_{wildcards.sample_id_pattern} {config['scratch']}$CONTIG_FILENAME 2>> {log[0]}
            """
