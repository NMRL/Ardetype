rule all:
    input:
        config['shape_target_files']      
    run:
        aggr_dict = {}
        
        #Combining agnostic typing results
        for path in config['shape_target_files']: 
            df = pd.read_csv(path)#read each file
            if df['sample_id'][0] in aggr_dict: #if sample included before
                aggr_dict[df['sample_id'][0]] = aggr_dict[df['sample_id'][0]].join(df.loc[ : ,df.columns != "sample_id"]) #add all columns except for sample_id
            else:
                aggr_dict[df['sample_id'][0]] = df #add all columns


        report = pd.concat(aggr_dict.values()) #combine all dataframes as rows into single report (one row for each sample_id)


        #Generating combined report
        general_columns = [ 
            "sample_id",
            "contig_count",
            "N50",
            "assembly_length",
            "gc_contigs",
            "MLST7_ST",
            "rMLST",
            "rMLST_Species",
            "rMLST_Support_%",
            "species",
            "species_contig_%",
            "taxid"
        ]

        #reorder columns
        optional_columns = sorted(list(set(report.columns) - set(general_columns)))
        order_list = general_columns + optional_columns
        report = report[order_list]

        #generate per-sample and per-batch tool reports
        print(f'shape: extracting tool/database versions', file=sys.stdout)
        wrapper = wp()
        wrapper.set_db_vers_map()
        wrapper.set_tool_vers_map()
        wrapper.report_tool_versions(output_path = config['output_directory'], sample_ids = report.sample_id)

        #add output folder name as analysis batch id
        report.insert(1, 'analysis_batch_id', [os.path.basename(os.path.dirname(config['output_directory'])) for _ in report.index])
        
        # #Prettify ids
        report.sample_id = report.sample_id.astype(str).str.replace(r'_S[0-9]*', '', regex=True)

        # #save as csv
        report.to_csv(config['output_directory']+f'{date}_ardetype_report.csv', header=True, index=False)


        # Combine profiles by species
        with open(config['output_directory']+'core_aggregated_taxonomy.json', "r") as json_handle:
            tax_map = json.load(json_handle)
        
        tax_df = pd.DataFrame(tax_map.items(), columns=['sample_id', 'species'])
        unq_spcs = tax_df['species'].unique()


        wd = os.path.join(config["output_directory"], 'cgmlst_aggregated')
        if os.path.isdir(wd):
            shutil.rmtree(wd)
        os.makedirs(wd)

        # For each detected species
        for sp in unq_spcs:
            samples = tax_df[tax_df['species'] == sp]['sample_id'].to_list()
            profiles = [os.path.join(config['output_directory'], f'{sample}_chewbbaca', 'results_alleles.tsv') for sample in samples]
            profiles = {s:p for s,p in zip(samples,profiles) if os.path.exists(p)}


            with tempfile.TemporaryDirectory() as tmpdir:
                # Copy profiles for processing
                new_map = {}
                for smp, pf in profiles.items():
                    dest_path = os.path.join(tmpdir, f'{smp}_results_alleles.tsv')
                    shutil.copy(pf, dest_path)
                    new_map[smp] = dest_path

                # Generate species template
                template = new_map[list(new_map.keys())[0]]
                
                combined_prof_path = os.path.join(wd,f'agg_results_alleles_{sp.lower().replace(" ","_")}.tsv')
                os.system(f'head -1 {template} > {combined_prof_path}')

                # Fill-in the template
                for s,p in new_map.items():
                    os.system(f'tail -1 {p} >> {combined_prof_path}')

                # Replace contigs suffix
                os.system(f"sed -i 's/_contigs//g' {combined_prof_path}")
                
                # Calculate distance matrix
                dm_path = os.path.join(wd,f'cgmlst-dists_{sp.lower().replace(" ","_")}.tsv')
                os.system(f'singularity --silent run --bind {config["output_directory"]}:{config["output_directory"]} {config["cgmlst_dists_sif"]} cgmlst-dists {combined_prof_path} > {dm_path}')


